{
  "name": "@phigon/superagent",
  "version": "0.1.5",
  "description": "Turns your coding agent (Claude Code, Codex, OpenCode, Cursor) into a Super-agent: an always-on router that runs other coding agents in parallel, each in its own git worktree.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imthegoodboy/SuperAgent.git"
  },
  "homepage": "https://github.com/imthegoodboy/SuperAgent#readme",
  "bugs": {
    "url": "https://github.com/imthegoodboy/SuperAgent/issues"
  },
  "bin": {
    "superagent": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "prepare": "npm run build",
    "start": "node dist/cli.js start",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "agent",
    "super-agent",
    "orchestrator",
    "router",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "multi-agent",
    "skill",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
