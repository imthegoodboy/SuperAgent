{
  "name": "@imthegoodboy/superagent",
  "version": "0.1.0",
  "description": "A local, always-on super-agent that orchestrates Claude Code, Codex, OpenCode and Cursor as parallel workers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imthegoodboy/SuperAgent.git"
  },
  "bin": {
    "superagent": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "prepare": "npm run build",
    "start": "node dist/cli.js start"
  },
  "keywords": [
    "agent",
    "orchestrator",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "multi-agent",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
