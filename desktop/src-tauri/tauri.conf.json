{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperAgent",
  "version": "0.1.0",
  "identifier": "dev.superagent.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SuperAgent",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "One always-on agent that runs your coding agents in parallel",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
